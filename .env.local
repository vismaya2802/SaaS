# ==============================================
# LOCAL DEVELOPMENT ENVIRONMENT VARIABLES
# ==============================================

# Frontend Environment Variables
# --------------------------------
# API base URL for local development
VITE_API_URL=http://localhost:8000

# Backend Environment Variables
# --------------------------------
# Python unbuffered output (better for logs)
PYTHONUNBUFFERED=1

# Database Configuration
DATABASE_URL=sqlite:///./data/visionframe.db

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: JWT Secret (for future authentication)
# JWT_SECRET=your-secret-key-here

# Optional: OTP Configuration (for future SMS integration)
# OTP_EXPIRY_MINUTES=5
# SMS_API_KEY=your-sms-api-key

# Optional: Payment Gateway (for future integration)
# RAZORPAY_KEY_ID=your-razorpay-key-id
# RAZORPAY_KEY_SECRET=your-razorpay-secret
