# ==============================================
# VERCEL PRODUCTION ENVIRONMENT VARIABLES
# ==============================================
# Copy these to Vercel Dashboard → Your Project → Settings → Environment Variables
# ==============================================

# IMPORTANT: Replace "your-project-name" with your actual Vercel project URL
# Example: https://visionframe-saas.vercel.app

# Frontend Build Variables (All Environments: Production, Preview, Development)
# -------------------------------------------------------------------------------
VITE_API_URL=https://your-project-name.vercel.app/api

# Backend Runtime Variables (All Environments)
# -------------------------------------------------------------------------------
PYTHONUNBUFFERED=1

# Database Configuration (Production)
# -------------------------------------------------------------------------------
# NOTE: SQLite doesn't work on Vercel serverless functions (read-only filesystem)
# You'll need to use a cloud database like:
# - Vercel Postgres
# - PlanetScale (MySQL)
# - Supabase (PostgreSQL)
# - MongoDB Atlas

# Example for Vercel Postgres (recommended):
# DATABASE_URL=postgres://user:password@host:5432/database

# CORS Origins (Production)
# -------------------------------------------------------------------------------
CORS_ORIGINS=https://your-project-name.vercel.app,https://www.your-custom-domain.com

# Optional: JWT Secret
# -------------------------------------------------------------------------------
JWT_SECRET=generate-a-secure-random-string-here-use-openssl-rand-base64-32

# Optional: OTP/SMS Service
# -------------------------------------------------------------------------------
# OTP_EXPIRY_MINUTES=5
# SMS_API_KEY=your-twilio-or-aws-sns-api-key
# SMS_API_SECRET=your-sms-api-secret

# Optional: Payment Gateway
# -------------------------------------------------------------------------------
# RAZORPAY_KEY_ID=your-razorpay-key-id
# RAZORPAY_KEY_SECRET=your-razorpay-secret

# Optional: Power BI Streaming
# -------------------------------------------------------------------------------
# POWERBI_STREAM_URL=https://api.powerbi.com/beta/...
# POWERBI_API_KEY=your-powerbi-api-key
