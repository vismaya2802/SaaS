# ==============================================
# VERCEL PRODUCTION ENVIRONMENT VARIABLES
# ==============================================
# Project Name: visionframe-app
# Project URL: https://visionframe-app.vercel.app
# ==============================================

# Frontend Build Variables (All Environments: Production, Preview, Development)
# -------------------------------------------------------------------------------
VITE_API_URL=https://visionframe-app.vercel.app/api

# Backend Runtime Variables (All Environments)
# -------------------------------------------------------------------------------
PYTHONUNBUFFERED=1

# CORS Origins (Production)
# -------------------------------------------------------------------------------
CORS_ORIGINS=https://visionframe-app.vercel.app

# Database Configuration (Production)
# -------------------------------------------------------------------------------
# NOTE: SQLite doesn't work well on Vercel (read-only filesystem, data lost on redeploy)
# For production, use a cloud database like Vercel Postgres, Supabase, or PlanetScale
DATABASE_URL=sqlite:///tmp/visionframe.db

# Optional: JWT Secret (for future authentication)
# -------------------------------------------------------------------------------
# JWT_SECRET=generate-a-secure-random-string-here

# Optional: OTP/SMS Service (for future integration)
# -------------------------------------------------------------------------------
# OTP_EXPIRY_MINUTES=5
# SMS_API_KEY=your-twilio-or-aws-sns-api-key

# Optional: Payment Gateway (for future integration)
# -------------------------------------------------------------------------------
# RAZORPAY_KEY_ID=your-razorpay-key-id
# RAZORPAY_KEY_SECRET=your-razorpay-secret

# Optional: Power BI Streaming (for future integration)
# -------------------------------------------------------------------------------
# POWERBI_STREAM_URL=https://api.powerbi.com/beta/...
# POWERBI_API_KEY=your-powerbi-api-key
